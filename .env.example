# Configuração Opcional do Supabase (PostgreSQL + Auth)
# Quando não configurado, o sistema opera automaticamente com o motor de persistência
# em servidor local (data/alcatrazz-db.json) + autenticação criptográfica HTTP-Only no servidor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Segredo criptográfico de sessão do Servidor (HMAC-SHA256)
ALCATRAZZ_SESSION_SECRET=zephira-world-alcatrazz-royal-secret-key-2026
